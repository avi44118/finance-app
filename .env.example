# Copy this file to .env for local `vercel dev`, and set the same values
# as Environment Variables in the Vercel project dashboard for deploys.
# Never commit the real .env file.

# Anthropic Claude API key — used ONLY by serverless functions in /api,
# never exposed to the browser. https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Supabase project (create a free project at https://supabase.com) — a
# separate project from the health app, its own URL and keys.
# SUPABASE_URL is your project's API URL (Project Settings > API).
SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY is the *service_role* secret key (Project
# Settings > API) — this bypasses row-level security and must only ever
# be used server-side in /api, never sent to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# The same shared passphrase used to gate the health app — set here as its
# own value in this project's env vars (Vercel doesn't share env vars
# across projects, so this is a separate copy of the same string, not a
# live link between the two apps).
APP_PASSPHRASE=

# Random 32+ character string used to sign the login session cookie.
# Generate one with: openssl rand -hex 32
SESSION_SECRET=

# Optional: protects api/rollup's monthly-compaction cron action from
# being triggered by anyone who finds the URL. Vercel automatically sends
# this as a Bearer token when it fires the cron job (Project Settings >
# Cron Jobs uses this env var automatically).
# generate one with: openssl rand -hex 32
CRON_SECRET=
